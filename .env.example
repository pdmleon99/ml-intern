# ML Intern — Environment Configuration
# No LLM keys here — users provide their own keys via the UI (BYOK)
# Server-side only config:

DATABASE_URL=sqlite+aiosqlite:///./data/ml_intern.db
MLFLOW_TRACKING_URI=http://localhost:5000
STORAGE_PATH=./data/storage
LARGE_DATASET_THRESHOLD=100000
SAMPLE_SIZE_LARGE=50000
MAX_TRAINING_TIMEOUT_SECONDS=300
MAX_UPLOAD_SIZE_MB=500
